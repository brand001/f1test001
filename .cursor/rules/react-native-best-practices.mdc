## Platform-Specific Code

### **Platform Checks**
```javascript
// ✅ Good - Handle platform differences
import { Platform } from 'react-native';

const LoginButton = () => (
  <TouchableOpacity 
    style={[
      styles.button,
      Platform.OS === 'ios' ? styles.iosButton : styles.androidButton
    ]}
  >
    <Text>登入</Text>
  </TouchableOpacity>
);

const styles = StyleSheet.create({
  button: {
    padding: 12,
    borderRadius: 8
  },
  iosButton: {
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.25,
    shadowRadius: 4
  },
  androidButton: {
    elevation: 4
  }
});
```

