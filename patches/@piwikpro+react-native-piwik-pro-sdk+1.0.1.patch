+RCT_REMAP_METHOD(destroy,
+                 destroyWithResolver:(RCTPromiseResolveBlock)resolve
+                 withRejecter:(RCTPromiseRejectBlock)reject)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        @try {
+            if (trackerInstance != nil) {
+                [trackerInstance dispatch]; // flush any pending events
+                trackerInstance = nil;
+            }
+
+            // 强制清除 sharedInstance 单例缓存
+            @try {
+                [PiwikTracker setValue:nil forKey:@"sharedInstance"];
+            } @catch (NSException *e) {
+                NSLog(@"[PiwikProSdk] Failed to reset sharedInstance: %@", e.reason);
+            }
+
+            resolve(nil);
+        } @catch (NSException *exception) {
+            reject(@"destroy_failed", exception.reason, nil);
+        }
+    });
+}
